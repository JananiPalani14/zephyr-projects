#include <zephyr/kernel.h>
#include <zephyr/sys/printk.h>
#include <zephyr/sys/byteorder.h>

#include <zephyr/bluetooth/bluetooth.h>
#include <zephyr/bluetooth/addr.h>

#include <zephyr/bluetooth/mesh.h>
#include <zephyr/bluetooth/mesh/access.h>
#include <zephyr/bluetooth/mesh/main.h>
#include <zephyr/bluetooth/mesh/msg.h>

/*
 * =========================================================
 *                 DEVICE CONFIGURATION
 * =========================================================

/*
 * This is the test company ID used by our BLE beacon.
 *
 * The beacon currently sends:
 *
 * FF FF | Asset ID | Sequence
 *
 * For the POC we use 0xFFFF as a test identifier.
 *
 * Replace it later with the appropriate assigned identifier.
#define BEACON_COMPANY_ID       0xFFFF

/*
 * Mesh vendor Company ID.
 *
 * Also a POC/test value.
 * Replace with the project's assigned Bluetooth SIG Company ID
 * for a real deployment.
#define MESH_COMPANY_ID         0xFFFF

/*
 * Our custom Mesh vendor model ID.
#define MESH_MODEL_ID           0x0001

/*
 * Vendor opcode used when B reports an asset observation
 * to A.
#define OP_ASSET_REPORT         BT_MESH_MODEL_OP_3(0x01, MESH_COMPANY_ID)

/*
 * A's primary Mesh element address.
 *
 * We will configure the nRF5340 provisioner/controller to use
 * address 0x0001 in the first POC.
#define CONTROLLER_ADDRESS      0x0001

/*
 * AppKey index.
 *
 * A will create/configure AppKey index 0 and bind it
 * to our vendor model.
#define APP_KEY_INDEX           0x0000

/*
 * NetKey index.
#define NET_KEY_INDEX           0x0000


/*
 * =========================================================
 *                 MESH PROVISIONING UUID
 * =========================================================
 *
 * This UUID identifies B as an unprovisioned Mesh device.
 *
 * For the first POC we use a fixed UUID.
 *
 * Later we can generate a unique UUID from the nRF52833
 * hardware ID.

static const uint8_t mesh_uuid[16] = {
	0xA1, 0x52, 0x52, 0x45,
	0x4C, 0x41, 0x59, 0x30,
	0x31, 0x00, 0x00, 0x00,
	0x00, 0x00, 0x00, 0x01
};


/*
 * =========================================================
 *                 BLE BEACON DATA
 * =========================================================
 *
 * C currently sends:
 *
 * Byte 0 : Company ID LSB
 * Byte 1 : Company ID MSB
 * Byte 2 : Asset ID
 * Byte 3 : Sequence byte 0
 * Byte 4 : Sequence byte 1
 * Byte 5 : Sequence byte 2
 * Byte 6 : Sequence byte 3
 *
 * Example:
 *
 * FF FF 01 15 00 00 00
 *
 * means:
 *
 * Company ID = 0xFFFF
 * Asset ID   = 1
 * Sequence   = 21


/*
 * Information extracted from one beacon packet.
struct asset_observation {
	uint8_t asset_id;
	uint32_t sequence;
	int8_t rssi;
};


/*
 * Last valid beacon observation.
static struct asset_observation last_asset;


/*
 * =========================================================
 *                 MESH VENDOR MODEL
 * =========================================================
 *
 * This model is responsible for our application-level
 * Asset Report message.
 *
 * B does not need to receive any vendor message initially.
 *
 * Therefore this is a SEND-ONLY application model.

static const struct bt_mesh_model_op vendor_ops[] = {
	BT_MESH_MODEL_OP_END,
};


/*
 * Vendor model.
 *
 * The model has no receive opcode yet.
static struct bt_mesh_model vendor_models[] = {
	BT_MESH_MODEL_VND(
		MESH_COMPANY_ID,
		MESH_MODEL_ID,
		vendor_ops,
		NULL,
		NULL
	),
};


/*
 * Primary element SIG models.
 *
 * Configuration Server is needed so that the provisioner
 * can configure B.
static struct bt_mesh_model sig_models[] = {
	BT_MESH_MODEL_CFG_SRV,
};


/*
 * Mesh element.
static struct bt_mesh_elem elements[] = {
	BT_MESH_ELEM(
		0,
		sig_models,
		vendor_models
	),
};


/*
 * Mesh composition.
static const struct bt_mesh_comp composition = {
	.cid = MESH_COMPANY_ID,
	.pid = 0x0001,
	.vid = 0x0001,

	.elem = elements,
	.elem_count = ARRAY_SIZE(elements),
};


/*
 * =========================================================
 *                 PROVISIONING CALLBACKS
 * =========================================================

static void provisioning_complete(uint16_t net_idx,
				  uint16_t addr)
{
	printk("\n");
	printk("========================================\n");
	printk("MESH PROVISIONING COMPLETE\n");
	printk("========================================\n");

	printk("NetKey Index : 0x%04X\n", net_idx);
	printk("Node Address : 0x%04X\n", addr);

	printk("Relay state  : %d\n",
	       bt_mesh_relay_get());

	printk("BLE scanner is still running\n");
	printk("\n");
}


static void provisioning_reset(void)
{
	printk("\n");
	printk("Mesh reset requested\n");
	printk("Node is no longer provisioned\n");
}


/*
 * Provisioning properties.
static const struct bt_mesh_prov provisioning = {
	.uuid = mesh_uuid,

	.complete = provisioning_complete,
	.reset = provisioning_reset,
};


/*
 * =========================================================
 *                 BLE BEACON PARSER
 * =========================================================


/*
 * This function is called for each advertising data field.
static bool parse_advertisement(struct bt_data *data,
				void *user_data)
{
	struct asset_observation *observation = user_data;

	/*
	 * We only care about Manufacturer Specific Data.
	 */
	if (data->type != BT_DATA_MANUFACTURER_DATA) {
		return true;
	}


	/*
	 * Our beacon packet must contain:
	 *
	 * 2 bytes company ID
	 * 1 byte asset ID
	 * 4 bytes sequence
	 *
	 * Total = 7 bytes
	 */
	if (data->data_len < 7) {
		return true;
	}


	/*
	 * Manufacturer Company ID is little endian.
	 */
	uint16_t company_id =
		data->data[0] |
		((uint16_t)data->data[1] << 8);


	/*
	 * Ignore every BLE device except our beacon.
	 */
	if (company_id != BEACON_COMPANY_ID) {
		return true;
	}


	/*
	 * Extract Asset ID.
	 */
	observation->asset_id = data->data[2];


	/*
	 * Extract 32-bit sequence number.
	 *
	 * The beacon sends the sequence in little endian.
	 */
	observation->sequence =
		((uint32_t)data->data[3]) |
		((uint32_t)data->data[4] << 8) |
		((uint32_t)data->data[5] << 16) |
		((uint32_t)data->data[6] << 24);


	/*
	 * We found our beacon.
	 *
	 * Returning false stops bt_data_parse().
	 */
	return false;
}


/*
 * =========================================================
 *                 SEND MESH ASSET REPORT
 * =========================================================
 *
 * Payload:
 *
 * Byte 0     Asset ID
 * Byte 1-4   Sequence
 * Byte 5     RSSI
 *
 * Total payload = 6 bytes


/*
 * Send one Asset Report from B to A.
static void send_asset_report(void)
{
	int err;


	/*
	 * B must first be provisioned.
	 */
	if (!bt_mesh_is_provisioned()) {

		printk("Mesh not provisioned - report not sent\n");

		return;
	}


	/*
	 * Create a Mesh message buffer.
	 *
	 * 6 bytes of application payload.
	 */
	BT_MESH_MODEL_BUF_DEFINE(
		msg,
		OP_ASSET_REPORT,
		6
	);


	/*
	 * Add our vendor opcode.
	 */
	bt_mesh_model_msg_init(
		&msg,
		OP_ASSET_REPORT
	);


	/*
	 * Add Asset ID.
	 */
	net_buf_simple_add_u8(
		&msg,
		last_asset.asset_id
	);


	/*
	 * Add Sequence Number.
	 */
	net_buf_simple_add_le32(
		&msg,
		last_asset.sequence
	);


	/*
	 * Add RSSI.
	 *
	 * RSSI is signed.
	 */
	net_buf_simple_add_u8(
		&msg,
		(uint8_t)last_asset.rssi
	);


	/*
	 * Define where the message goes.
	 *
	 * AppKey 0
	 * Destination = A
	 * Default Mesh TTL
	 */
	struct bt_mesh_msg_ctx ctx =
		BT_MESH_MSG_CTX_INIT(
			NET_KEY_INDEX,
			APP_KEY_INDEX,
			CONTROLLER_ADDRESS,
			BT_MESH_TTL_DEFAULT
		);


	/*
	 * Send the message using our vendor model.
	 */
	err = bt_mesh_model_send(
		&vendor_models[0],
		&ctx,
		&msg,
		NULL,
		NULL
	);


	if (err) {

		printk("Mesh report send FAILED: %d\n",
		       err);

		return;
	}


	printk("Mesh report SENT -> A\n");
}


/*
 * =========================================================
 *                 BLE SCAN CALLBACK
 * =========================================================
static void scan_recv(const struct bt_le_scan_recv_info *info,
                      struct net_buf_simple *buf)
{
        struct asset_observation observation;

        observation.asset_id = 0;
        observation.sequence = 0;
        observation.rssi = info->rssi;

        bt_data_parse(buf, parse_advertisement, &observation);

        if (observation.asset_id == 0) {
                return;
        }

        last_asset = observation;

        printk("\n");
        printk("========================================\n");
        printk("ASSET BEACON DETECTED\n");
        printk("========================================\n");
        printk("Asset ID : %u\n", last_asset.asset_id);
        printk("Sequence : %u\n", last_asset.sequence);
        printk("RSSI     : %d dBm\n", last_asset.rssi);
        printk("========================================\n");

        send_asset_report();
}

int main(void)
{
	int err;


	printk("\n");
	printk("========================================\n");
	printk("       ASSET RELAY / SCANNER\n");
	printk("========================================\n");


	/*
	 * Start Bluetooth.
	 */
	err = bt_enable(NULL);

	if (err) {

		printk("Bluetooth initialization failed: %d\n",
		       err);

		return 0;
	}


	printk("Bluetooth initialized\n");

      static struct bt_le_scan_cb scan_cb = {
            .recv = scan_recv,
            .timeout = NULL,
         };

       err = bt_le_scan_cb_register(&scan_cb);

       if (err) {
             printk("Scan callback registration failed: %d\n", err);
             return 0;
         }

printk("BLE scan callback registered\n");
	/*
	 * Initialize Bluetooth Mesh.
	 */
	err = bt_mesh_init(
		&provisioning,
		&composition
	);

	if (err) {

		printk("Mesh initialization failed: %d\n",
		       err);

		return 0;
	}


	printk("Bluetooth Mesh initialized\n");


	/*
	 * Restore previously stored Mesh state.
	 */
	if (IS_ENABLED(CONFIG_SETTINGS)) {

		err = settings_load();

		if (err) {

			printk("Settings load failed: %d\n",
			       err);
		}
	}


	/*
	 * Print current Mesh state.
	 */
	printk("Provisioned : %s\n",
	       bt_mesh_is_provisioned() ? "YES" : "NO");

	printk("Relay state : %d\n",
	       bt_mesh_relay_get());


	/*
	 * If B is not provisioned yet, make it available
	 * for provisioning.
	 */
	if (!bt_mesh_is_provisioned()) {

		err = bt_mesh_prov_enable(
			BT_MESH_PROV_ADV |
			BT_MESH_PROV_GATT
		);

		if (err) {

			printk("Provisioning enable failed: %d\n",
			       err);

			return 0;
		}

		printk("Waiting for Mesh provisioning...\n");
	}


	/*
	 * -----------------------------------------------------
	 * Start BLE scanning.
	 *
	 * Passive scanning is enough because our beacon data
	 * is already contained in the advertisement packet.
	 *
	 * No duplicate filtering:
	 * We want to observe changing sequence numbers.
	 * -----------------------------------------------------
	 */
	printk("BLE scanner callback ready\n");
	printk("Looking for ASSET_BEACON_01...\n");


	/*
	 * Main thread can sleep.
	 *
	 * BLE scanner and Mesh stack work asynchronously.
	 */
	while (1) {

		k_sleep(K_SECONDS(10));

		printk(
			"System alive | Mesh=%s | Relay=%d\n",
			bt_mesh_is_provisioned()
				? "PROVISIONED"
				: "NOT PROVISIONED",
			bt_mesh_relay_get()
		);
	}

	return 0;
}
